# Copy to .env and fill in. Never commit the real .env.

# --- Brickken Dapp API (API-key + credit based) ---
BRICKKEN_API_KEY=
BRICKKEN_DAPP_API_BASE_URL=https://api.brickken.com   # TODO: confirm exact base URL against docs.brickken.com

# --- Chain config ---
CHAIN_ID=11155111                                      # Ethereum Sepolia
SEPOLIA_RPC_URL=                                        # e.g. an Alchemy/Infura Sepolia endpoint
BASE_SEPOLIA_RPC_URL=                                   # only needed if Agentic API calls route through Base Sepolia

# --- Wallets (private keys — testnet only, never reuse a mainnet key) ---
# Generated by `npm run setup:wallet`. Keep each agent's key distinct so RAMS
# mandate boundaries are demonstrably about authority, not shared custody.
ISSUER_AGENT_PRIVATE_KEY=
OPS_AGENT_PRIVATE_KEY=
COMPLIANCE_AGENT_PRIVATE_KEY=

# --- Agentic API / x402 ---
BRICKKEN_AGENTIC_API_BASE_URL=                          # TODO: confirm — Agentic API / MCP server base URL
X402_FAUCET_ENDPOINT=                                    # TODO: confirm — the "pay 0.01 USDC -> mint 100 BKN" endpoint
USDC_TOKEN_ADDRESS_SEPOLIA=                               # TODO: confirm sandbox USDC contract address
BKN_TOKEN_ADDRESS_SEPOLIA=                                # TODO: confirm BKN 2.0 Sepolia contract address

# --- Reward wallet (for submission) ---
REWARD_WALLET_ADDRESS=
